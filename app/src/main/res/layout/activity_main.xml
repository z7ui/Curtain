<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="幕布"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_perm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="#EEE"
        android:text="① 点击授予悬浮窗权限" />

    <TextView
        android:id="@+id/tv_usage_perm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="#EEE"
        android:text="② 点击授予「使用情况访问」权限（用于抓取应用图标）" />

    <Button
        android:id="@+id/btn_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="检查权限状态" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="亮度级别（0 最亮，4 最暗）" />

    <SeekBar
        android:id="@+id/sb_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_level_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="级别 4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="自动息屏时间" />

    <SeekBar
        android:id="@+id/sb_timeout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_timeout_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15 秒" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="② 下拉控制中心，把「幕布」磁贴拖出来，点击启动" />
</LinearLayout>